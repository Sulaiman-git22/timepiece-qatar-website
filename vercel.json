{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noai, noimageai"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.sc-cdn.net https://*.cdninstagram.com https://*.fbcdn.net; media-src 'self'; connect-src 'self'; frame-src https://www.instagram.com https://www.snapchat.com https://www.google.com https://maps.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/((?!blocked\\.html|robots\\.txt).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|Claude-Web|Claude-User|Claude-SearchBot|anthropic-ai|CCBot|PerplexityBot|Perplexity-User|Bytespider|Amazonbot|Applebot-Extended|Google-Extended|FacebookBot|Meta-ExternalAgent|meta-externalagent|Meta-ExternalFetcher|meta-externalfetcher|cohere-ai|cohere-training-data-crawler|Diffbot|ImagesiftBot|YouBot|Timpibot|omgili|omgilibot|DuckAssistBot|MistralAI-User|AI2Bot|Ai2Bot-Dolma|img2dataset|FirecrawlAgent|Crawlspace|Kangaroo Bot|PanguBot|Sidetrade|Webzio-Extended|iaskspider|Brightbot|Scrapy|PetalBot|Bytedance|python-requests|Python-urllib|python-urllib|aiohttp|httpx|Go-http-client|node-fetch|axios|undici|HeadlessChrome|PhantomJS|libwww-perl|Wget|curl/|Java/|okhttp|colly|Puppeteer|Playwright).*"
        }
      ],
      "destination": "/blocked.html",
      "permanent": false
    }
  ]
}